---
import BaseLayout from './BaseLayout.astro';
import { webpageSchema, breadcrumbSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  updated?: string;
  path: string;
}

const { title, description, updated = '22 Kasım 2026', path } = Astro.props;
const schemas = [
  webpageSchema(path, title, description),
  breadcrumbSchema([
    { name: 'Ana Sayfa', path: '/' },
    { name: title, path },
  ]),
];
---

<BaseLayout title={`${title} | Adana Matematik Özel Ders`} description={description} canonical={path} schemas={schemas}>
  <article class="legal-page container">
    <p class="eyebrow">Yasal bilgilendirme</p>
    <h1>{title}</h1>
    <p class="updated">Son güncelleme: {updated}</p>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
